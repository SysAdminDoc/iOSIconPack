<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon wrapper that exposes a monochrome layer for Android 13+
    themed-icon support. Launchers read this when the user enables "Themed icons".
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ios14_themed_icon_background" />
    <foreground android:drawable="@drawable/ios14_discord" />
    <monochrome android:drawable="@drawable/ios14_discord_mono" />
</adaptive-icon>
