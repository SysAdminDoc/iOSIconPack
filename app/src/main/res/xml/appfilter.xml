    <item component="ComponentInfo{com.spotify.music/com.spotify.music.MainActivity}" drawable="ios18_music" />

    <!-- ==================== -->
    <!-- WALLET / PAY         -->
    <!-- ==================== -->
    <item component="ComponentInfo{com.google.android.apps.walletnfcrel/com.google.android.apps.walletnfcrel.WalletActivity}" drawable="ios18_wallet" />

    <!-- ==================== -->
    <!-- FILES                -->
    <!-- ==================== -->
    <item component="ComponentInfo{com.google.android.apps.nbu.files/com.google.android.apps.nbu.files.home.HomeActivity}" drawable="ios18_files" />
    <item component="ComponentInfo{com.samsung.android.app.myfiles/com.samsung.android.app.myfiles.MyFilesActivity}" drawable="ios18_files" />

    <!-- ==================== -->
    <!-- CALCULATOR           -->
    <!-- ==================== -->
    <item component="ComponentInfo{com.google.android.calculator/com.android.calculator2.Calculator}" drawable="ios18_calculator" />
    <item component="ComponentInfo{com.samsung.android.calculator/com.samsung.android.calculator.Calculator}" drawable="ios18_calculator" />

    <!-- ==================== -->
    <!-- HEALTH / FITNESS     -->
    <!-- ==================== -->
    <item component="ComponentInfo{com.google.android.apps.fitness/com.google.android.apps.fitness.FitMainActivity}" drawable="ios18_health" />
    <item component="ComponentInfo{com.samsung.android.shealth/com.samsung.android.shealth.app.home.HomeActivity}" drawable="ios18_health" />

    <!-- ==================== -->
    <!-- SOCIAL MEDIA         -->
    <!-- ==================== -->
    <item component="ComponentInfo{com.instagram.android/com.instagram.mainactivity.InstagramMainActivity}" drawable="ios18_camera" />
    <item component="ComponentInfo{com.twitter.android/com.twitter.app.main.MainActivity}" drawable="ios18_safari" />
    <item component="ComponentInfo{com.whatsapp/com.whatsapp.HomeActivity}" drawable="ios18_messages" />
    <item component="ComponentInfo{org.telegram.messenger/org.telegram.ui.LaunchActivity}" drawable="ios18_messages" />
    <item component="ComponentInfo{com.discord/com.discord.main.MainActivity}" drawable="ios18_messages" />

    <!-- ==================== -->
    <!-- YOUTUBE              -->
    <!-- ==================== -->
    <item component="ComponentInfo{com.google.android.youtube/com.google.android.youtube.HomeActivity}" drawable="ios18_facetime" />

</resources>
